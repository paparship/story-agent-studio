  "texts": {
    "town_road_check.title": "镇口路况核对",
    "t_dc36d09c45ca.title": "已接受委托：通知守卫",
    "t_1b91e96d88e3.title": "已通知守卫：等待会合",
    "t_807a297bd1cf.title": "会合完成：回报联络员",
    "t_048ebcaa4544.title": "任务完成",
    "liaison_talk.n_46": "守卫就在镇口附近，去通知他吧。",
    "liaison_talk.n_43": "他们碰完面后再来确认吧。",
    "liaison_talk.n_40": "路已经确认过了。",
    "liaison_talk.n_36": "好，北路可以通行，委托完成。",
    "liaison_talk.liaison_report_complete": "路况确认了吗？",
    "liaison_talk.n_29": "你已经接过这个委托了。",
    "liaison_talk.liaison_accept_errand": "请通知守卫，到镇口一起核对路况。",
    "guard_talk.n_102": "你还没接委托吧。",
    "guard_talk.n_99": "路况已经确认了。",
    "guard_talk.n_96": "已经会合过了，去找联络员吧。",
    "guard_talk.n_93": "会合结束，去告诉联络员吧。",
    "guard_talk.n_91": "那我就按北路安排送货。",
    "guard_talk.n_90": "北路可以通行。",
    "guard_talk.n_88": "方向没对准，稍后再试。",
    "guard_talk.n_81": "有人还没到，我们稍后再试。",
    "guard_talk.guard_retry_meeting": "我们再去碰个面。",
    "guard_talk.n_71": "会合结束，去告诉联络员吧。",
    "guard_talk.n_69": "那我就按北路安排送货。",
    "guard_talk.n_68": "北路可以通行。",
    "guard_talk.n_66": "方向没对准，稍后再试。",
    "guard_talk.n_59": "有人还没到，我们稍后再试。",
    "guard_talk.guard_first_notify": "知道了，我们去碰个面。"
  },
